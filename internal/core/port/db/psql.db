CREATE TABLE "users" (
  "user_id" guid PRIMARY KEY,
  "first_name" varchar,
  "last_name" varchar,
  "email" varchar,
  "phone" varchar,
  "password" string,
  "role" varchar,
  "created_at" timestamp,
  "updated_at" timestamp,
  "last_login" timestamp
);

CREATE TABLE "sessions" (
  "session_id" guid,
  "user_id" guid,
  "token" varchar,
  "ip_address" varchar(45),
  "user_agent" text,
  "created_at" timestamp,
  "expires_at" timestamp,
  "last_access" timestamp,
  "is_active" bool,
  "location" varchar
);

CREATE TABLE "property" (
  "user_id" guid,
  "property_id" guid,
  "tariff_plan" varchar
);

CREATE TABLE "basic_info" (
  "basic_info_id" guid,
  "main_title" varchar,
  "type" varchar,
  "category" varchar,
  "price" int,
  "keywords" varchar,
  "property_id" guid
);

CREATE TABLE "location" (
  "location_id" guid,
  "phone" varchar(13),
  "mail" string,
  "city" string,
  "address" string,
  "longitude" decimal(9,6),
  "latitude" decimal(8,6),
  "property_id" guid
);

CREATE TABLE "nearby" (
  "places" varchar,
  "distance" int,
  "property_id" guid
);

CREATE TABLE "property_media" (
  "type" string,
  "image" string,
  "background_image" string,
  "property_id" guid
);

CREATE TABLE "property_details" (
  "area" decimal(10,2),
  "bedrooms" int,
  "bathrooms" int,
  "parking" int,
  "accomodation" varchar,
  "website" string,
  "property_details" text,
  "property_id" guid
);

CREATE TABLE "amenities" (
  "wifi" bool,
  "pool" bool,
  "security" bool,
  "laundry_room" bool,
  "equipped_kitchen" bool,
  "air_conditioning" bool,
  "parking" bool,
  "garage_atached" bool,
  "fireplace" bool,
  "window_covering" bool,
  "backyard" bool,
  "fitness_gym" bool,
  "elevator" bool,
  "property_id" guid
);

CREATE TABLE "plans_brochures" (
  "file_type" varchar,
  "file_path" varchar,
  "property_id" guid
);

CREATE TABLE "accordion_widget" (
  "accordion_exist" bool,
  "accordion_title" string,
  "accordion_details" text,
  "property_id" guid
);

CREATE TABLE "video_widget" (
  "video_exist" bool,
  "video_title" string,
  "youtube_url" string,
  "vimeo_url" string,
  "property_id" guid
);

ALTER TABLE "sessions" ADD FOREIGN KEY ("user_id") REFERENCES "users" ("user_id");

ALTER TABLE "video_widget" ADD FOREIGN KEY ("property_id") REFERENCES "property" ("property_id");

ALTER TABLE "location" ADD FOREIGN KEY ("property_id") REFERENCES "property" ("property_id");

ALTER TABLE "amenities" ADD FOREIGN KEY ("property_id") REFERENCES "property" ("property_id");

ALTER TABLE "nearby" ADD FOREIGN KEY ("property_id") REFERENCES "property" ("property_id");

ALTER TABLE "plans_brochures" ADD FOREIGN KEY ("property_id") REFERENCES "property" ("property_id");

ALTER TABLE "basic_info" ADD FOREIGN KEY ("property_id") REFERENCES "property" ("property_id");

ALTER TABLE "accordion_widget" ADD FOREIGN KEY ("property_id") REFERENCES "property" ("property_id");

ALTER TABLE "property_media" ADD FOREIGN KEY ("property_id") REFERENCES "property" ("property_id");

ALTER TABLE "property_details" ADD FOREIGN KEY ("property_id") REFERENCES "property" ("property_id");

ALTER TABLE "property" ADD FOREIGN KEY ("user_id") REFERENCES "users" ("user_id");
